# GitHub OAuth App. For development, register your own under your account
# with callback URL http://localhost:8787/auth/github/callback and browse the
# dev server at localhost, not 127.0.0.1. Requests no scopes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord application (Developer Portal). Redirect URI
# http://localhost:8787/auth/discord/callback. Requests the identify scope only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Local Postgres from `pnpm run db:up`; devops injects the production value.
DATABASE_URL=postgres://ethglossary:ethglossary@127.0.0.1:5432/ethglossary

# Optional. Enables ENS names and smart-contract wallet signatures for
# Sign-In with Ethereum; without it, EOA wallets still work and there is no ENS.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional. How long a boot may wait on the database (whole seconds, min 5).
# DB_STARTUP_TIMEOUT=60
