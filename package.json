{
  "name": "ethglossary",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:fonts": "node scripts/build-fonts.mjs",
    "check": "tsc --noEmit",
    "build:css": "tailwindcss -i src/ui/app.css -o public/assets/app.css",
    "build": "pnpm run build:fonts && pnpm run build:css"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@scalar/hono-api-reference": "^0.10.7",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.81.1"
  }
}
