{
  "name": "ethglossary",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:assets && node scripts/dev.mjs",
    "start": "node dist/server.js",
    "build": "pnpm run build:assets && pnpm run bundle",
    "build:assets": "pnpm run build:fonts && pnpm run build:css",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:css": "tailwindcss -i src/ui/app.css -o public/assets/app.css",
    "bundle": "node scripts/build-server.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.3.0",
    "@scalar/hono-api-reference": "^0.10.7",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
